# E-Library Mobile App Environment Variables
# Copy to .env (never commit .env to git)

# ─── Backend API URL ───────────────────────────────────────────────────────
# For local development on a PHYSICAL PHONE:
# Replace 192.168.x.x with your computer's actual local IP
# (run `ipconfig` on Windows to find it)
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:5000

# For production backend:
# EXPO_PUBLIC_API_BASE_URL=https://library-management-system-backend-8cbu.onrender.com
