# Environment Variables for E-Library Mobile App
# Copy this file to .env and fill in the values

# Backend API base URL
# For local development with a physical phone, use your computer's local IP, e.g.:
# API_BASE_URL=http://192.168.1.100:5000
# For production (Render/Railway/Vercel backend):
# API_BASE_URL=https://your-backend.onrender.com
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:5000
